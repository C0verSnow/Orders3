# Copy to config in the repository root. UI saves take effect immediately.
# Manual file edits take effect after restart. Uses the server's local timezone.
# Five fields: minute hour day month weekday (0 or 7 = Sunday).
[schedule]
enabled = true
cron = */15 * * * *

# Managed by the application's settings form. Values are JSON-quoted strings.
# Saved fields override environment variables and legacy .env values.
# ORDERS_CONFIG_PATH remains a startup environment variable.
# [environment]
# SUPABASE_URL = "https://your-project.supabase.co"
# SUPABASE_ANON_KEY = "your-publishable-key"
# API_KEY = "your-gate-api-key"
# API_SECRET = "your-gate-api-secret"
# ORDERS_DATA_DIR = ""
# ORDERS_ALLOWED_ORIGIN = ""
