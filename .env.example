# Copy this file to .env in the repository root; it is loaded automatically.
# Existing environment variables take precedence over .env values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
# Optional: defaults to data/data.db when running from the source repository.
# Relative paths are resolved from the current working directory.
# ORDERS_DATA_DIR=./data
# Optional: only used by the C++ launcher; defaults to python (then py on Windows).
# Run from the repository root when using this relative interpreter path.
# PYTHON=./.venv/Scripts/python.exe
