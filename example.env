# Configure connection settings in the application; no .env file is required.
# Optional legacy .env: repository root, beside orders.exe (Windows), or bin/orders (Linux).
# Application-saved config values take precedence over environment variables and .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
# Gate trailing order list (--list); never put real credentials in source code.
API_KEY=your-gate-api-key
API_SECRET=your-gate-api-secret
# Optional: defaults to data/data.db when running from the source repository.
# Relative paths are resolved from the current working directory.
# ORDERS_DATA_DIR=./data
# Optional: scheduled configuration file (default: config in source builds,
# ~/.orders-dashboard/config in release packages).
# ORDERS_CONFIG_PATH=./config
# Optional: browser origin when using a proxy or different public port.
# ORDERS_ALLOWED_ORIGIN=http://127.0.0.1:8090
